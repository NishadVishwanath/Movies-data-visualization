	column rating
		dataType: double
		lineageTag: 6f7d1d84-9f14-4218-b18a-649cd4912613
		summarizeBy: sum
		sourceColumn: rating

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column timestamp
		dataType: int64
		formatString: 0
		lineageTag: 7de1fa91-1f06-4ebc-9d91-f0b25378acef
		summarizeBy: sum
		sourceColumn: timestamp

		annotation SummarizationSetBy = Automatic

